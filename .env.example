# .env.example – copy to .env and customise
# These are read at startup before data/settings.json overrides are applied.
# Settings changed in the GUI override these at runtime and are saved to data/settings.json.

# HTTP listener bind address (127.0.0.1 = localhost only)
P1_HOST=127.0.0.1

# HTTP listener port
P1_PORT=8787

# Deduplication cooldown in seconds
P1_COOLDOWN=60

# Flash interval in milliseconds
P1_FLASH_MS=600

# Sound mode: beep | wav | silent
P1_SOUND_MODE=beep

# Path to WAV file (used when P1_SOUND_MODE=wav)
# P1_WAV_PATH=assets/alert.wav

# Authentication
P1_AUTH_ENABLED=false
P1_SHARED_SECRET=

# Maximum history entries kept in memory
P1_MAX_HISTORY=100
